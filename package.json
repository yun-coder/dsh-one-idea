{
  "name": "dsh-one-idea",
  "version": "0.4.0",
  "type": "module",
  "description": "创意工作台：一句话想法或一段剧本 → 导演确认 → 创意 idea → 故事剧情 → 分镜脚本 → 人物六维 → 配音方案 → 出片 → 成片剪辑。生产 Agent、剪辑团队 Agent、审核 Agent 三方协作，质量不过自动打回并通知复核；内置拉片台（爆款拆解 + 逐镜判定 + 复刻分镜）。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "video",
    "storyboard",
    "shot-contract",
    "creative"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "engine",
    "tools",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE",
    "machine.json.example",
    "test"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node test/selftest.mjs && node test/panel-smoke.mjs && node test/panel-api.mjs && node test/intake-api.mjs && node test/reference-api.mjs && node test/voice-smoke.mjs",
    "test:voice": "node test/voice-smoke.mjs",
    "eval": "node test/eval.mjs",
    "doctor": "node test/doctor.mjs",
    "i18n": "node tools/audit-i18n.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yun-coder/dsh-one-idea.git"
  },
  "homepage": "https://github.com/yun-coder/dsh-one-idea#readme",
  "bugs": {
    "url": "https://github.com/yun-coder/dsh-one-idea/issues"
  }
}
